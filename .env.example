# Copy to .env (or set in your hosting dashboard) before building.
# NEXT_PUBLIC_* values are baked in at BUILD time — rebuild after changing.

# Canonical site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://howmuchbuild.com

# Contact email shown on the Contact page
NEXT_PUBLIC_CONTACT_EMAIL=contact@howmuchbuild.com

# Display name for the site author/organization
NEXT_PUBLIC_AUTHOR_NAME=The HowMuchBuild Team

# Set to "true" only after an ad network approves the site.
# While false, all ad placeholder slots stay hidden.
NEXT_PUBLIC_ADS_ENABLED=false

# AdSense publisher ID used by the /ads.txt route.
# Replace with your real ID (ca-pub-XXXXXXXXXXXXXXXX) after approval.
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=pub-0000000000000000
